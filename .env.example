# ===========================================================================
# Enterprise RAG Assistant — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Models (defaults are cost-effective, change if needed)
# ---------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Storage (defaults work for local development)
# ---------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=enterprise_docs
CHECKPOINT_DIR=./checkpoints

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# RATE_LIMIT_PER_MINUTE=30/minute
# Rate limit for expensive endpoints (/ingest, /upload, /eval)
# HEAVY_RATE_LIMIT=5/minute
# Server-side ingestion (/ingest) is restricted to paths under this root
# INGEST_ROOT=./data
# Graph checkpointer: "memory" (default, request-scoped) or "sqlite" (durable)
# GRAPH_CHECKPOINTER=memory
# API key the Streamlit UI uses to call the API (one of API_KEYS)
# RAG_API_KEY=

# ---------------------------------------------------------------------------
# Security (enable for production)
# ---------------------------------------------------------------------------
# AUTH_ENABLED=true
# API_KEYS=generate-with-openssl-rand-hex-32
# GUARDRAILS_ENABLED=true
# PII_DETECTION_ENABLED=true
# MAX_QUERY_LENGTH=2000
# DEBUG_MODE=false

# ---------------------------------------------------------------------------
# CORS (lock to your UI domain in production)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:8501

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# RRF_K=60
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CROSS_ENCODER_DEVICE=cpu

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
# MEMORY_ENABLED=true
# INTENT_DETECTION_ENABLED=true
# QUERY_TRANSFORM_ENABLED=true
# Unified analysis: one LLM call replaces intent_detect + query_transform +
# planner (cuts ~2-4s latency & ~30-40% per-query LLM cost). When on, the
# three flags above are bypassed on the in-scope path.
# UNIFIED_ANALYSIS=false
# SEMANTIC_CACHE_ENABLED=false
# KNOWLEDGE_GRAPH_ENABLED=false
# PARALLEL_SUB_QUERIES=false
# ENABLE_TOOLS=false
# MCP_ENABLED=false
# Critic verification: "always" (default), "adaptive" (skip low-risk short
# answers the grader already vouched for), or "off"
# CRITIC_MODE=always
# CRITIC_SKIP_MAX_CHARS=600

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=2
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60

# ---------------------------------------------------------------------------
# Cost Control
# ---------------------------------------------------------------------------
# COST_ALERT_THRESHOLD=0.05
# COST_BUDGET_PER_QUERY=0.02

# ---------------------------------------------------------------------------
# Async ingestion pipeline
#   upload -> object store -> event queue -> worker -> vector DB
# Off by default: /upload parses and embeds inline and returns 200.
# Turn it on and /upload stores the file, queues an event and returns 202;
# run `python -m scripts.worker` to do the indexing.
# ---------------------------------------------------------------------------
# ASYNC_INGESTION=false

# Object storage: "local" (filesystem, no extra deps) or "s3"
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./object_store
# S3_BUCKET=enterprise-rag-documents
# S3_REGION=us-east-1
# S3_PREFIX=documents
# Point at MinIO or any S3-compatible store; blank means real AWS
# S3_ENDPOINT_URL=http://minio:9000

# Event bus: "sqlite" (durable local queue, no broker needed) or "kafka"
# EVENT_BUS=sqlite
# EVENT_BUS_PATH=./checkpoints/event_bus.db
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_TOPIC_INGESTION=document.uploaded
# KAFKA_TOPIC_DLQ=document.uploaded.dlq
# KAFKA_CONSUMER_GROUP=ingestion-workers

# Worker retry policy — attempts before the event is dead-lettered
# INGEST_MAX_ATTEMPTS=3
# INGEST_RETRY_BACKOFF_S=2.0
# How long a claimed event stays invisible before it is redelivered
# INGEST_VISIBILITY_TIMEOUT_S=300
# WORKER_POLL_INTERVAL_S=1.0
# WORKER_BATCH_SIZE=1
# DOCUMENT_REGISTRY_PATH=./checkpoints/documents.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# One JSON object per log line, including the request id — for log
# aggregators, and for following one upload across API, queue and worker.
# JSON_LOGS=false

# ---------------------------------------------------------------------------
# Optional: Tavily web search (get a key at tavily.com)
# ---------------------------------------------------------------------------
# TAVILY_API_KEY=tvly-your-key-here

# ---------------------------------------------------------------------------
# Optional: LangSmith tracing (get a key at smith.langchain.com)
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-your-key-here
# LANGSMITH_PROJECT=enterprise-rag-assistant
