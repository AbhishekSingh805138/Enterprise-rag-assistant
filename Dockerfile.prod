# ============================================================
# Production Dockerfile — Enterprise RAG Assistant
# Multi-stage build for smaller image + non-root user
# ============================================================

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Build from the lockfile so an image built today and one built in six
# months contain byte-identical dependencies. --require-hashes additionally
# refuses any artifact whose checksum does not match, which is what turns
# the pin into a supply-chain control rather than just a version record.
#
# Regenerate after changing requirements.txt (run inside this same base
# image so the pins match the target platform):
#   docker run --rm -v "$PWD:/w" -w /w python:3.11-slim sh -c \
#     "pip install uv && uv pip compile requirements.txt \
#      --generate-hashes --output-file requirements.lock"
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir --prefix=/install --require-hashes -r requirements.lock

# Stage 2: Production image
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Create non-root user
RUN groupadd -r raguser && useradd -r -g raguser -d /app -s /sbin/nologin raguser

# Create directories for persistent data (volumes will override these)
RUN mkdir -p /app/chroma_db /app/checkpoints /app/data && \
    chown -R raguser:raguser /app

# Copy application code
COPY --chown=raguser:raguser . .

# Switch to non-root user
USER raguser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CHROMA_DIR=/app/chroma_db \
    CHECKPOINT_DIR=/app/checkpoints

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Single worker: rate limiting, circuit breakers, BM25 cache, and the
# SQLite stores are process-local. Multiple workers would give each its
# own divergent copy (and 2x the PyTorch/cross-encoder memory). Scale by
# adding replicas once those stores move to Redis/Postgres.
# --proxy-headers trusts X-Forwarded-For from the reverse proxy so rate
# limiting keys on the real client IP, not the proxy's.
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--timeout-keep-alive", "120"]
